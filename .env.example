# LLM_PROVIDER controls which LLMClient implementation the app uses.
# - "mock"      : deterministic, offline, no API key needed (default for tests/CI)
# - "anthropic" : real calls via langchain-anthropic (needs ANTHROPIC_API_KEY)
# - "openai"    : real calls via langchain-openai (needs OPENAI_API_KEY)
LLM_PROVIDER=mock
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: point MLflow at a tracking server. Defaults to a local ./mlruns folder.
MLFLOW_TRACKING_URI=
